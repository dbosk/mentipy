A server is the real command line in a process of its own.  Asking the system for a
free port leaves a moment in which someone else can take it, and the machines this
runs on are busy, so the wait for the server also watches the process: a server
that lost the port exits, and we must not take somebody else's server for ours.

The file size limit is for the [[fsize]] scenario.  It is set inside the server
after the import, not by a [[preexec_fn]], which is unsafe with the respondents'
threads running, and not before the import, or Python's own compiled files would
meet it.

<<run methods>>=
def _start_server(self, port, file_size_limit=None):
    command = [
        sys.executable,
        "-c",
        _server_code(file_size_limit),
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        str(port),
        "--store",
        str(self.store),
    ]
    process = self._start_process(
        command,
        env=self.environment,
        stdout=self.server_log,
        stderr=self.server_log,
    )
    deadline = time.monotonic() + SERVER_START_TIMEOUT
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise HarnessError(
                f"the server on port {port} exited with"
                f" {process.returncode} while starting"
            )
        try:
            socket.create_connection(("127.0.0.1", port), 0.2).close()
            return process
        except OSError:
            time.sleep(0.05)
    raise HarnessError(f"the server on port {port} did not start")


def restart_server(self, index, *, kill, file_size_limit=None):
    """Stop a server, by SIGKILL or by SIGINT, and start it on its port again."""

    server = self.servers[index]
    if kill:
        server.kill()
        server.wait()
    else:
        self._stop_server(server)
    self.servers[index] = self._start_server(
        self.ports[index], file_size_limit
    )


def _stop_server(self, server):
    server.send_signal(signal.SIGINT)
    try:
        server.wait(SERVER_STOP_TIMEOUT)
    except subprocess.TimeoutExpired:
        self.problems.append("a server did not stop on SIGINT")
        server.kill()
        server.wait()
<<functions>>=
def free_port():
    """Return a port that was free a moment ago."""

    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


def _server_code(file_size_limit):
    code = "from mentipy.cli import main\n"
    if file_size_limit is not None:
        limits = (file_size_limit, file_size_limit)
        code += (
            "import resource\n"
            f"resource.setrlimit(resource.RLIMIT_FSIZE, {limits})\n"
        )
    return code + "main()\n"
<<classes>>=
class HarnessError(Exception):
    """The scenarios could not run, which says nothing about the answers."""


<<constants>>=
CLI_CODE = "from mentipy.cli import main\nmain()\n"
SERVER_START_TIMEOUT = 30
SERVER_STOP_TIMEOUT = 10
