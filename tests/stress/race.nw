if not accepted:
    self.problems.append("no answer was accepted, so this tested nothing")
if self.refused and not self.scenario.limits_file_size:
    statuses = sorted(set(map(str, self.refused)))
    self.problems.append(
        f"{len(self.refused)} answers refused: {statuses[:5]}"
    )
if self.no_reply and not self.scenario.interrupts_server:
    errors = sorted(set(self.no_reply))
