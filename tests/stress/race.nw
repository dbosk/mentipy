Options go straight to this program, through [[make stress STRESSFLAGS="..."]], so the
Makefile does not need to know them.  The scenarios are positional because they are
what one most often wants to choose.

<<main functions>>=
def parse_arguments(argv=None):
    """Read the command line."""

    parser = argparse.ArgumentParser(
        description="Stress Mentipy's answers with real servers and builds."
    )
    parser.add_argument(
        "scenarios",
        nargs="*",
        metavar="SCENARIO",
        help=f"what to run, by default all of: {' '.join(SCENARIOS)}",
    )
    parser.add_argument(
        "--seconds",
        type=float,
        default=DEFAULT_SECONDS,
        help="how long each scenario runs (default: %(default)s)",
    )
    parser.add_argument(
        "--dir",
        type=Path,
        default=Path(DEFAULT_DIRECTORY),
        help="where to work, not in memory (default: %(default)s)",
    )
    parser.add_argument(
        "--source",
        type=Path,
        default=Path(__file__).resolve().parents[2] / "src",
        help="directory holding the mentipy package to test",
    )
    parser.add_argument(
        "--old-python",
        type=Path,
        help=f"a Python with Mentipy {OLD_MENTIPY}, instead of installing it",
    )
    parser.add_argument(
        "--keep",
        action="store_true",
        help="keep the working directory and say where it is",
    )
    arguments = parser.parse_args(argv)
    arguments.scenarios = arguments.scenarios or list(SCENARIOS)
    unknown = sorted(set(arguments.scenarios) - set(SCENARIOS))
    if unknown:
        parser.error(f"unknown scenario: {' '.join(unknown)}")
    if arguments.seconds <= 0:
        parser.error("--seconds must be positive")
    return arguments
