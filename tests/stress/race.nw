A signal has to go the same way as an exception, through every [[finally]], or an
interrupted run leaves its servers running.  SIGKILL is the one signal that cannot do
that, and then the servers of that moment stay and have to be stopped by hand.  The
handler first switches itself off, because a second Ctrl-C during the clean-up would
otherwise abandon it half-way.  Output goes line by line, since a run takes minutes
and [[make]] may be writing to a pipe, and an interrupted run should show how far it
came.

<<main functions>>=
class Interrupted(BaseException):
    """A signal asked this program to stop."""


def _interrupted(signum, _frame):
    for handled in HANDLED_SIGNALS:
        signal.signal(handled, signal.SIG_IGN)
    raise Interrupted(signum)


def print_table(outcomes):
    """Print one line for each scenario that ended."""

    if outcomes:
        print(TABLE_LINE.format(*TABLE_HEADINGS))
    for outcome in outcomes:
        print(
            TABLE_LINE.format(
                outcome.name,
                f"{outcome.seconds:.0f}",
                outcome.builds,
                outcome.accepted,
                outcome.stored,
                outcome.lost,
                outcome.refused,
                outcome.no_reply,
                outcome.problems,
            )
        )


def main(argv=None):
    """Run the scenarios asked for and return the exit status."""

    arguments = parse_arguments(argv)
    sys.stdout.reconfigure(line_buffering=True)
    for handled in HANDLED_SIGNALS:
        signal.signal(handled, _interrupted)
    outcomes, status, scratch = [], None, None
    try:
        kind = check_real_disk(arguments.dir)
        scratch = Path(
            tempfile.mkdtemp(
                dir=arguments.dir.resolve(), prefix=SCRATCH_PREFIX
            )
        )
        print(f"working in {scratch} ({kind})")
        settings = prepare_settings(arguments, scratch)
        for name in arguments.scenarios:
            outcomes.append(run_scenario(name, settings, scratch))
    except Interrupted as interruption:
        print(f"interrupted by signal {interruption.args[0]}", file=sys.stderr)
        status = 128 + interruption.args[0]
    except (HarnessError, subprocess.SubprocessError, OSError) as error:
        print(f"race.py: {error}", file=sys.stderr)
        status = 2
    finally:
        if scratch is not None and not arguments.keep:
            shutil.rmtree(scratch, ignore_errors=True)
    print_table(outcomes)
    if scratch is not None and arguments.keep:
        print(f"kept {scratch}")
    if status is not None:
        return status
    failed = [outcome.name for outcome in outcomes if outcome.failed]
    if failed:
        print(f"FAILED: {' '.join(failed)}")
        return 1
    print("every accepted answer was found")
    return 0
<<constants>>=
HANDLED_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
SCRATCH_PREFIX = "mentipy-stress-"
TABLE_HEADINGS = (
    "scenario",
    "secs",
    "builds",
    "accepted",
    "stored",
    "lost",
    "refused",
    "no reply",
    "problems",
)
TABLE_LINE = (
    "{:<12} {:>5} {:>7} {:>9} {:>7} {:>5} {:>8} {:>9} {:>9}"
)
