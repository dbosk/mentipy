\section{The builds}

A build is a real process running the helpers a PythonTeX block calls.  It asks the
server's three questions again, so that the merge rewrites their entries, asks one
question whose text changes from build to build, the edit a lecturer makes between
two compiles, and adds some more to make the store bigger and each write longer.

<<constants>>=
BUILD_CODE = """
import sys
from mentipy.latex import mc, open_text
tag, fillers = sys.argv[1], int(sys.argv[2])
open_text("Open one?", qr_format="png")
open_text("Open two?", qr_format="png")
mc("Pick?", ["A", "B"], qr_format="png")
open_text(f"Edited in build {tag}?", qr_format="png")
for number in range(fillers):
    open_text(f"Filler {number}?", qr_format="png")
"""
BUILD_TIMEOUT = 300
<<the state of a run>>=
self.builds = 0
self.killed_builds = 0
<<run methods>>=
def start_build(self, *, old=False, fillers=20):
    """Start a real build on the run's store, with the old Mentipy if `old`."""

    self.builds += 1
    python = self.settings.old_python if old else sys.executable
    environment = self.old_environment if old else self.environment
    command = [python, "-c", BUILD_CODE, str(self.builds), str(fillers)]
    return self._start_process(
        command,
        env=environment,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )


def finish_build(self, build):
    """Wait for a build, and note it as a problem if it failed by itself."""

    _, errors = build.communicate(timeout=BUILD_TIMEOUT)
    if build.returncode not in (0, -signal.SIGKILL):
        last_line = (errors.strip().splitlines() or ["no output"])[-1]
        self.problems.append(
            f"a build exited with {build.returncode}: {last_line[:160]}"
        )


def build(self, *, old=False, fillers=20, kill_after=None):
    """Run a real build to its end, or SIGKILL it after `kill_after` seconds."""

    build = self.start_build(old=old, fillers=fillers)
    if kill_after is not None:
        try:
            build.wait(kill_after)
        except subprocess.TimeoutExpired:
            build.kill()
            self.killed_builds += 1
    self.finish_build(build)


def question_count(self):
    """Return the number of questions in the store's file right now."""

    return len(json.loads(self.store.read_text())["questions"])
