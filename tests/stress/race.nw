Every process of a run gets the config file of the run, so nothing in the user's
own configuration can change what is tested.  The Mentipy under test comes from
[[PYTHONPATH]] and the old one must not see it, or the old build would quietly run
the new code.  [[prepare_settings]] verifies both (\cref{sec:main}).

<<functions>>=
def mentipy_environment(config, source=None):
    """Return the environment for a Mentipy process using the file `config`."""

    environment = dict(os.environ, MENTIPY_CONFIG=str(config))
    environment.pop("PYTHONPATH", None)
    if source is not None:
        environment["PYTHONPATH"] = str(source)
    return environment
<<imports>>=
import os
<<run methods>>=
def start(self):
    """Set up the store, start the servers and let the answers begin."""

    config = self.directory / "config.json"
    config.write_text("{}")
    self.environment = mentipy_environment(config, self.settings.source)
    self.old_environment = mentipy_environment(config)
    self.prefixes = json.loads(
        subprocess.run(
            [sys.executable, "-c", SET_UP_QUESTIONS],
            cwd=self.directory,
            env=self.environment,
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    )
    self.server_log = open(self.directory / "server.log", "ab")
    for _ in range(self.scenario.servers):
        self.ports.append(free_port())
        self.servers.append(self._start_server(self.ports[-1]))
    self._start_threads()
    self.started_at = time.monotonic()
    self.deadline = self.started_at + self.settings.seconds


def running(self):
    """Tell whether the scenario's time is still running."""

    return time.monotonic() < self.deadline


def _start_process(self, command, **options):
    process = subprocess.Popen(
        command, cwd=self.directory, **options
    )
    self.children.append(process)
    return process
