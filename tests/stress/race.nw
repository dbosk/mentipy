<<functions>>=
def _answer_values(results):
    return [answer["value"] for answer in results.get("answers", [])]


def _missing_answers(key, accepted, values):
    if key in OPEN_QUESTIONS:
        have = set(values)
        return sum(value not in have for value in accepted)
    return max(0, len(accepted) - len(values))
<<classes>>=
@dataclass(frozen=True)
class QuestionReading:
    """What the readers found for one question."""

    key: str
    accepted: int
    stored: int
    lost: int
    extra: int
    counts: dict

    def __str__(self):
        counts = " ".join(f"{k} {n}" for k, n in self.counts.items())
        return (
            f"{self.key}: accepted {self.accepted} stored {self.stored}"
            f" lost {self.lost} extra {self.extra} | {counts}"
        )
@

The readers on the far side of HTTP and of the command line.  The output of the command
line is decoded here, not by [[subprocess]], whose text mode would turn the carriage
return in an answer into a newline and so report a loss that did not happen.  For the
same reason the CSV goes through a [[StringIO]] that leaves newlines alone.

<<run methods>>=
def _results_json(self, prefix):
    status, body = self.http_get(f"/{prefix}/results.json?window=all")
    if status != 200:
        self.problems.append(f"{prefix}: results.json gave status {status}")
        return {}
    return json.loads(body)


def _page_count(self, prefix):
    status, body = self.http_get(f"/{prefix}/results?window=all")
    match = re.search(r"Total responses: <strong>(\d+)</strong>", body)
    if status != 200 or match is None:
        self.problems.append(f"{prefix}: no total on the page ({status})")
        return 0
    return int(match.group(1))


def _cli(self, *arguments):
    return subprocess.run(
        [sys.executable, "-c", CLI_CODE, *arguments, "--store", str(self.store)],
        cwd=self.directory,
        env=dict(self.environment, PYTHONUTF8="1"),
        capture_output=True,
        timeout=READ_TIMEOUT,
    )


def _cli_output(self, *arguments):
    done = self._cli(*arguments)
    if done.returncode:
        self.problems.append(
            f"mentipy {' '.join(arguments)} exited with {done.returncode}"
        )
    return done.stdout.decode("utf-8", "replace")


def _export_json(self, prefix):
    output = self._cli_output("export", prefix, "--format", "json")
    try:
        return json.loads(output)
    except ValueError:
        self.problems.append(f"{prefix}: export json is not JSON")
        return {}


def _export_csv_values(self, prefix):
    output = self._cli_output("export", prefix, "--format", "csv")
    rows = list(csv.reader(io.StringIO(output, newline="")))
    return [row[1] for row in rows[1:]]


def _view_count(self, prefix):
    output = self._cli_output("view", prefix, "--window", "all")
    match = re.search(r"Responses[^0-9]*(\d+)", output)
    if match is None:
        self.problems.append(f"{prefix}: view shows no number of responses")
        return 0
    return int(match.group(1))


def read_back(self):
    """Ask every reader for every question, while the server is still up."""

    log_values, self.malformed_lines, self.torn_bytes = self._read_answer_log()
    hashes = {
        question["url_prefix"]: full_hash
        for full_hash, question in json.loads(self.store.read_text())[
            "questions"
        ].items()
    }
    rows = [
        self._read_question(
            key, log_values.get(hashes.get(self.prefixes[key]), [])
        )
        for key in QUESTIONS
    ]
    if self._cli("list").returncode:
        self.problems.append("mentipy list failed")
    return rows
