The next tests pin what the store file itself says, so they read the raw
JSON rather than going through [[remembered_qr_targets]], which would
hide a relative entry behind the absolute path it resolves to.  Where a
test only wants the files the store stands behind, it lists the paths
of the targets that are not foreign.  A deck's QR
directory lies inside the deck, next to the store, so its entry must
not name the directory the deck happens to be checked out in.

<<test functions>>=
def _remembered_paths(store, full_hash):
    return [
        target.path
        for target in store.remembered_qr_targets(full_hash)
        if target.kind != FOREIGN_QR_TARGET
    ]


def _raw_qr_paths(store_path, full_hash):
    data = json.loads(store_path.read_text(encoding="utf-8"))
    return data["questions"][full_hash].get(QR_PATHS_KEY)


def _write_raw(store_path, full_hash, key, entries):
    data = json.loads(store_path.read_text(encoding="utf-8"))
    data["questions"][full_hash][key] = entries
    store_path.write_text(json.dumps(data), encoding="utf-8")


