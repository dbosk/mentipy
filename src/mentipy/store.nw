def _edit_link(path, full_hash, target):
    data = json.loads(path.read_text())
    data["questions"][full_hash][REGISTERED_AFTER_KEY] = target
    path.write_text(json.dumps(data, indent=2) + "\n")


def test_the_walk_ends_on_cycles_and_dangling_links(tmp_path):
    path = tmp_path / "mentipy.json"
    store = _build(path, _deck("Q1", "Q2", "Q3"))
    h1, h2, h3 = _hashes(_deck("Q1", "Q2", "Q3"))

    _edit_link(path, h1, h3)
    assert _live_sequence(store) == [h1, h2, h3]

    _edit_link(path, h2, "f" * 64)
    assert _live_sequence(store) == [h2, h3]

    _edit_link(path, h2, ["not", "a", "hash"])
    assert _live_sequence(store) == [h2, h3]


