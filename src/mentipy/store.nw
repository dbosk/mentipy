An older [[mentipy serve]], on another machine or in a course repository
that has not upgraded, still reads the serials: it walks back from the
last question while each serial is one less than the next.  The serials
the current code writes are the positions in the run, so the run's head
has serial~1, nothing can have serial~0, and the old rule stops exactly
where the link chain does.  The test applies that rule, kept as the
legacy fallback, to the stores of all the scenarios above.

<<test functions>>=
@pytest.mark.parametrize("runs", [1, 2])
@pytest.mark.parametrize("change", list(DECK_CHANGES))
def test_old_readers_find_the_same_live_sequence(tmp_path, change, runs):
    path = tmp_path / "mentipy.json"
    store = _build(path, _deck("Q1", "Q2", "Q3", "Q4", "Q5"), runs=runs)
    assert _live_hashes_by_serials(store._data()["questions"]) == (
        _live_sequence(store)
    )

    _build(path, _deck(*DECK_CHANGES[change]), runs=runs)

    data = json.loads(path.read_text())
    assert _live_hashes_by_serials(data["questions"]) == _live_sequence(store)
    assert "registration_counter" not in data
