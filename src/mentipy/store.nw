    nested = _nested_worktree(main, "deck/mentipy.json")
    sibling = _checkout(tmp_path / "sibling", worktree=True)
    deck = main / "deck"
    store = Store(deck / "mentipy.json", min_prefix=4)
    prefix, full_hash = _new_question(store)
    orphan_prefix, orphan = _new_question(store)
    own = deck / f"mentipy-obj/Q-{prefix}.pdf"
    orphan_own = deck / f"handout/Q-{orphan_prefix}.png"
    for directory in (own.parent, orphan_own.parent,
