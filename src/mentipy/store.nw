The remaining tests need checkouts.  Mentipy recognises one by the
[[.git]] entry at its root, a directory in a clone and a file in a
worktree, so that is all a test has to create.

<<test functions>>=
def _checkout(path, *, worktree=False):
    path.mkdir(parents=True, exist_ok=True)
    if worktree:
        (path / ".git").write_text("gitdir: elsewhere\n", encoding="utf-8")
    else:
        (path / ".git").mkdir()
    return path


def _new_question(store):
    number = len(store.all_questions())
    prefix = store.register(OpenQuestion(f"Comment {number}?"))
    return prefix, store.resolve(prefix)
