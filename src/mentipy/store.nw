    everything = store.results(full_hash, window="all")
    store.mark_server_start()
    restarted = store.results(full_hash, window="session")

    assert session["window"] == "session"
    assert session["total"] == 1
    assert session["counts"] == [0, 1]
    assert everything["total"] == 2
    assert restarted["total"] == 0


