<<test functions>>=
def test_package_facade_reexports_the_public_api():
    assert MCQuestion.__name__ == "MCQuestion"
    assert OpenQuestion.__name__ == "OpenQuestion"
    assert ScaleQuestion.__name__ == "ScaleQuestion"
    assert WordCloudQuestion.__name__ == "WordCloudQuestion"
    assert RankingQuestion.__name__ == "RankingQuestion"
    assert PinImageQuestion.__name__ == "PinImageQuestion"
    assert PinTextQuestion.__name__ == "PinTextQuestion"
    assert issubclass(PinImageQuestion, PinQuestion)
    assert issubclass(PinTextQuestion, PinQuestion)
    assert issubclass(PinQuestion, Question)
    assert callable(mc)
    assert callable(open_text)
    assert callable(pin_image)
    assert callable(pin_text)
    assert callable(question)
    assert callable(ranking)
    assert callable(scale)
    assert callable(word_cloud)
    assert callable(serve)
    assert callable(create_venv)
    assert callable(install_package)
    assert callable(activation_script)
    assert Store.__name__ == "Store"
    assert callable(set_base_dir)
    assert callable(get_base_dir)
    assert callable(base_dir)
    assert callable(resolve_path)
    assert callable(write_snippet)
    assert ContextSnippet.__name__ == "ContextSnippet"
    assert ContextDownload.__name__ == "ContextDownload"
    assert callable(file_snippet)
    assert callable(file_download)
    assert __version__ == metadata.version("mentipy")
@

A source tree on [[sys.path]] has no metadata, and that case cannot run for
real here: the package's dependencies and its metadata share one
[[site-packages]], so a process that can import Mentipy can also find the
metadata.  The test therefore injects the failure.  It needs a process of its
own because the version is read once, when the package is first imported.

<<test functions>>=
_WITHOUT_METADATA = """\
from importlib import metadata

def missing(name):
    raise metadata.PackageNotFoundError(name)

metadata.version = missing
import mentipy
print(mentipy.__version__)
"""


def test_the_version_is_unknown_without_package_metadata():
    result = subprocess.run(
        [sys.executable, "-c", _WITHOUT_METADATA],
        capture_output=True,
        text=True,
        timeout=60,
    )

    assert result.returncode == 0, result.stderr
    assert result.stdout.strip() == "unknown"
@
