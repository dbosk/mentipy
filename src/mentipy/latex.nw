    [entry] = store.all_questions()
    prefix = entry["url_prefix"]

    assert "How was the lecture?" in rendered
    assert f"\\input{{{QR_SUBPATH}/Q-{prefix}.pdf_tex}}" in rendered
    assert (tmp_path / DEFAULT_QR_DIR / f"Q-{prefix}.pdf").exists()
    assert (tmp_path / DEFAULT_QR_DIR / f"Q-{prefix}.pdf_tex").exists()
