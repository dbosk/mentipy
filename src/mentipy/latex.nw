The macros only matter if a real document typesets them, so the last
test compiles two small Beamer decks with [[pdflatex]] and reads the
PDF's text back.  The first, in English with no definitions of its
own, must read exactly as the slides did before the labels became
macros, for every question kind.  The snippets go straight into
ordinary frames, as pasted [[mentipy render]] output would, the case
that rules out macro arguments.  The second is a Swedish deck that
overrides two labels in its preamble, one with a number: the overrides
must win on every frame, including the later ones, where a frame-local
default could otherwise have crept back in.  The PDF's text is
normalised to composed characters, since the default font encoding
builds [[ä]] from an [[a]] and an accent.  The test is skipped where [[pdflatex]] or [[pdftotext]]
is missing.

<<test functions>>=
needs_pdflatex = pytest.mark.skipif(
    not (shutil.which("pdflatex") and shutil.which("pdftotext")),
    reason="needs pdflatex and pdftotext",
)


def _compiled_text(directory, preamble, snippets):
    frames = "".join(
        f"\\begin{{frame}}\n{snippet}\n\\end{{frame}}\n"
        for snippet in snippets
    )
    (directory / "deck.tex").write_text(
        "\\documentclass{beamer}\n"
        f"{preamble}\n"
        "\\begin{document}\n"
        f"{frames}"
        "\\end{document}\n",
        encoding="utf-8",
    )
    latex = subprocess.run(
        ["pdflatex", "-interaction=nonstopmode", "-halt-on-error",
         "deck.tex"],
        cwd=directory, capture_output=True, text=True, timeout=120,
    )
    assert latex.returncode == 0, latex.stdout[-2000:]
    text = subprocess.run(
        ["pdftotext", "deck.pdf", "-"],
        cwd=directory, capture_output=True, text=True, check=True,
    ).stdout
    return " ".join(unicodedata.normalize("NFC", text).split())


@needs_pdflatex
def test_compiled_slides_keep_the_english_and_take_a_deck_override(
    tmp_path, monkeypatch
):
    common = _label_test_setup(tmp_path, monkeypatch)
    english = _compiled_text(tmp_path, "", [
        mc("Q1", ["A", "B"], **common),
        mc("Q2", ["A", "B"], multi=True, **common),
        open_text("Q3", **common),
        scale("Q4", low_label="never", high_label="always", **common),
        word_cloud("Q5", **common),
        ranking("Q6", ["A", "B"], **common),
        ranking("Q7", ["A", "B", "C"], top_n=2, **common),
        pin_text("Q8", "x = 1", **common),
        pin_text("Q9", "y = 2", max_pins=3, allow_comment=True, **common),
        word_cloud("Q10", split_words=False, **common),
        word_cloud("Q11", separators=",;", **common),
    ])
    for phrase in [
        "Choose exactly one:",
        "Choose one or more:",
        "Type Free-text answer Limit 280 characters",
        "Range 1–5 Low never High always",
        "Type Word-cloud (free-text) Limit 280 characters"
        " Min word length 3",
