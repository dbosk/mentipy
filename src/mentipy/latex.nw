A label's text is written into LaTeX, so it is escaped like any other
text, while the number stays a macro call.  No built-in label has a
special character today, so the test brings its own catalogue.

<<test functions>>=
def test_slide_label_definitions_escape_the_label_text():
    labels = latex_module._SlideLabels(
        Catalogue("xx", {"slide.limit": "50% & {n} $"})
    )

    call = labels("slide.limit", 3)

    assert call == "{\\def\\mentipynumber{3}\\mentipylimitlabel{}}"
    assert labels.definitions() == (
        "\\providecommand{\\mentipylimitlabel}"
        "{50\\% \\& \\mentipynumber{} \\$}%\n"
    )
