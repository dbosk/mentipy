    qr_format: str | None = None,
    environment: str | None = None,
    show_url: bool | None = None,
    layout: str = DEFAULT_LAYOUT,
    locale: str | None = None,
) -> str:
    """Return LaTeX for an open free-text question."""

    active_store = store or Store()
    return question(
        OpenQuestion(
            text=text,
            max_chars=max_chars,
            fence=fence,
            next=next,
            results=results,
            lock=lock,
            context=_resolve_context(context, active_store),
        ),
        store=active_store,
        base_url=base_url,
        qr_dir=qr_dir,
        qr_format=qr_format,
        environment=environment,
        show_url=show_url,
        layout=layout,
        locale=locale,
    )
@

The scale wrapper captures the common numeric-rating case.  Bounds and labels
