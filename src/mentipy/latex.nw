The tests below render through the public helpers, each with a
configuration file of its own, because the locale comes from the
configuration and a test must not read the developer's.  By default
the labels are the English words the slides always showed, defined
where they are used: a multiple-choice snippet calls its instruction
and defines it, and does not define an open question's labels.  A
label with a number reads it from [[\mentipynumber]], which the snippet
sets in a group around the call.  With a question environment the
definitions still come first, outside it.

<<test functions>>=
def _label_test_setup(tmp_path, monkeypatch, locale=None):
    monkeypatch.chdir(tmp_path)
    monkeypatch.setenv("MENTIPY_CONFIG", str(tmp_path / "config.json"))
    if locale is not None:
        set_setting("locale", locale)
    return dict(
        store=Store(tmp_path / "mentipy.json", min_prefix=4),
        base_url="http://example.test:8080",
        qr_dir=DEFAULT_QR_DIR,
    )


def test_slide_labels_are_macros_with_the_english_words_by_default(
    tmp_path, monkeypatch
):
    common = _label_test_setup(tmp_path, monkeypatch)

    single = mc("Which?", ["A", "B"], **common)
    multi = mc("Which ones?", ["A", "B"], multi=True, **common)
    free = open_text("Why?", max_chars=140, **common)

    assert (
        "\\providecommand{\\mentipychooseone}{Choose exactly one:}%\n"
        in single
    )
    assert "\\emph{\\mentipychooseone{}}" in single
    assert "mentipytypelabel" not in single
    assert "{Choose one or more:}" in multi
    assert "\\emph{\\mentipychoosemany{}}" in multi
    assert (
        "\\providecommand{\\mentipycharacters}"
        "{\\mentipynumber{} characters}%\n" in free
    )
    assert (
        "\\item[\\mentipylimitlabel{}] "
        "{\\def\\mentipynumber{140}\\mentipycharacters{}}" in free
    )
    assert "#" not in single + multi + free

    framed = open_text("Why?", environment="exercise", **common)
    assert framed.index("\\providecommand{\\mentipytypelabel}") < (
        framed.index("\\begin{exercise}")
    )
@

