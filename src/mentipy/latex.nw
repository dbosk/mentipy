BANK_SOURCE = """import functools


class Account:
    \"\"\"A bank account.\"\"\"

    def deposit(self, amount):
        self.balance += amount


class Bank:
    pass


@functools.cache
def interest(rate):
    return rate * 2
"""


@pytest.fixture
def bank_file(tmp_path, monkeypatch):
    monkeypatch.chdir(tmp_path)
    Path("bank.py").write_text(BANK_SOURCE)


def test_file_snippet_shows_a_whole_file_in_its_language(bank_file):
