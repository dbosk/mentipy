def test_slide_labels_follow_the_locale_setting(tmp_path, monkeypatch):
    common = _label_test_setup(tmp_path, monkeypatch, locale="sv_SE")

    swedish = ranking("Order?", ["A", "B", "C"], top_n=2, **common)
