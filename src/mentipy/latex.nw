        BANK_SOURCE, language="python", label="bank.py"
    )


def test_file_snippet_takes_a_class_or_a_method_by_name(bank_file):
    account = file_snippet("bank.py", name="Account")
    deposit = file_snippet("bank.py", name="Account.deposit")

    assert account.text == (
        "class Account:\n"
        '    """A bank account."""\n'
        "\n"
        "    def deposit(self, amount):\n"
        "        self.balance += amount\n"
    )
    assert account.label == "bank.py: Account"
    assert deposit.text == (
        "def deposit(self, amount):\n    self.balance += amount\n"
    )


def test_file_snippet_keeps_the_decorators(bank_file):
    assert file_snippet("bank.py", name="interest").text == (
        "@functools.cache\ndef interest(rate):\n    return rate * 2\n"
    )
