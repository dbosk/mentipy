\subsection{Opening the browser}

The browser command is replaced by a spy, since a test must not open
windows on the machine that runs it.  The spy records the argument
list and the keywords of every process [[present]] starts, and checks
that the server already listens when it is called.  Its [[wait]]
behaves like a browser that keeps running: it records the thread that
waits and blocks until the test releases it, so a [[present]] that
waited in its own thread would never finish.  The rest of the run is
real, as in the tests above.

<<test functions>>=
class _BrowserSpy:
    calls = []
    waiters = []
    waited = threading.Event()
    released = threading.Event()

    def __init__(self, argv, **options):
        url = next(
            (arg[arg.index("http://") :] for arg in argv if "http://" in arg),
            "http://127.0.0.1:1",
        )
        parts = urllib.parse.urlsplit(url)
        with socket.socket() as probe:
            listening = probe.connect_ex((parts.hostname, parts.port)) == 0
        _BrowserSpy.calls.append(
            {"argv": argv, "options": options, "listening": listening}
        )

    def wait(self, *_args, **_kwargs):
        _BrowserSpy.waiters.append(threading.current_thread())
        _BrowserSpy.waited.set()
        _BrowserSpy.released.wait(timeout=30)
        return 0

    def communicate(self, *_args, **_kwargs):
        raise AssertionError("present must not talk to the browser")


@pytest.fixture
def browser_spy(monkeypatch):
    _BrowserSpy.calls = []
    _BrowserSpy.waiters = []
    _BrowserSpy.waited = threading.Event()
    _BrowserSpy.released = threading.Event()
    monkeypatch.setattr("mentipy.cli.subprocess.Popen", _BrowserSpy)
    yield _BrowserSpy.calls
    _BrowserSpy.released.set()


def _run_present(tmp_path, monkeypatch, *extra, steps=()):
    monkeypatch.setenv("MENTIPY_CONFIG", str(tmp_path / "config.json"))
    port = _free_port()
    set_setting("base_url", f"http://127.0.0.1:{port}")
    _play_the_lecture(monkeypatch, *steps)
    result = CliRunner().invoke(
        cli,
        [
            "present",
            "--host",
            "127.0.0.1",
            "--port",
            str(port),
            "--store",
            str(tmp_path / "mentipy.json"),
            *extra,
        ],
    )
    return result, port
