The heading's response count names its window unless it is everything,
in the words of the results page's filter.  A lecturer who looks at the
terminal after a restart, or after the break with another window, would
otherwise read a small count as lost answers.  The session is the
\emph{last} start: with no server running, [[mentipy view]] after the
lecture still counts that lecture's answers.  The open-question
watcher prints the count again with every new answer, and names the
window there too.

<<constants>>=
RESULTS_WINDOW_NAMES = {
    "session": "since the last server start",
    "hour": "last hour",
    "day": "last day",
}
<<functions>>=
def _responses_count(results: dict) -> str:
    count = str(results["total"])
    name = RESULTS_WINDOW_NAMES.get(results.get("window", "all"))
    return f"{count} ({name})" if name else count


def _responses_line(results: dict) -> str:
    return f"Responses: {_responses_count(results)}"
@

The full result renderer is shared by [[view]] and the first frame of
[[watch]].  It uses the same summary fields as the HTML page:
multiple-choice mode and option percentages, scale descriptive
statistics and bucket percentages, word-cloud frequency tables,
ranking mean ranks, pin heatmaps, and open-text average answer length
before the transcript.  Every kind opens with the same heading, so it
is printed once, before the dispatch, by a helper that the
open-question watcher shares.

The prompt in the heading is the lecturer's text, and Rich reads two
things in a printed string that a programming prompt is full of: a
bracketed word as style markup, which drops the \texttt{[i]} of
\texttt{xs[i]}, and a word between colons as an emoji code, which
turns the \texttt{:b:} of \texttt{s[a:b:c]} into a symbol.  The
heading is therefore printed with both off.  Highlighting stays on, so
the counts keep their colour.

<<functions>>=
def _print_heading(results: dict, *, console: Console):
    lines = [
        results["question"]["text"],
        f"Prefix: {results['url_prefix']}",
        _responses_line(results),
        "",
    ]
    console.print("\n".join(lines), markup=False, emoji=False)


def _render_results(
    results: dict,
    *,
    console: Console,
    pin_heat: str = DEFAULT_PIN_HEAT,
):
    question = results["question"]
    _print_heading(results, console=console)

    if question["kind"] == "mc":
        _render_terminal_mc_stats(question, results, console=console)
        _render_terminal_bar_chart(
            [str(option) for option in question["options"]],
            list(results["counts"]),
            list(results["percentages"]),
            console=console,
        )
        return

    if question["kind"] == "scale":
        _render_terminal_scale_stats(results, console=console)
        values = list(range(int(question["low"]), int(question["high"]) + 1))
        counts = [int(results["counts"].get(value, 0)) for value in values]
        denominator = int(results["total"]) or 1
        _render_terminal_bar_chart(
            [str(value) for value in values],
            counts,
            [count / denominator * 100 for count in counts],
            console=console,
        )
        return

    if question["kind"] == "wordcloud":
        _render_terminal_wordcloud(results, console=console)
        return

    if question["kind"] == "ranking":
        _render_terminal_ranking_stats(question, results, console=console)
        return

    if question["kind"] in ("pinimage", "pintext"):
        _render_terminal_pin_stats(
            question, results, console=console, pin_heat=pin_heat
        )
        return

    _render_terminal_open_stats(results, console=console)

    if results["answers"]:
        _render_open_answers(results["answers"], console=console)
    else:
        console.print("No answers yet.")
