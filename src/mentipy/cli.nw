Under [[--public ssh]] a loopback request is no longer admin, so the
URL carries the run's token.  The test asks the real server for the
URL the browser was given: the server must answer as it answers the
lecturer's admin link, by setting the admin cookie and redirecting to
the bare index.

<<test functions>>=
def test_present_opens_the_tokenised_index_under_ssh(
    tmp_path, monkeypatch, browser_spy
):
    monkeypatch.setenv("MENTIPY_CONFIG", str(tmp_path / "config.json"))
    set_setting("ssh_tunnel", "alice@example.test:9000")

    @contextmanager
    def fake_expose(_mode, _local_port, *, ssh_endpoint=None):
        yield "http://public.example:9000"

    monkeypatch.setattr("mentipy.cli.expose", fake_expose)
    answers = {}

    def follow_the_link():
        parts = urllib.parse.urlsplit(browser_spy[0]["argv"][-1])
        connection = http.client.HTTPConnection(
            parts.hostname, parts.port, timeout=5
        )
        connection.request("GET", f"{parts.path}?{parts.query}")
        response = connection.getresponse()
        response.read()
        answers["status"] = response.status
        answers["cookie"] = response.getheader("Set-Cookie") or ""
        connection.close()

    result, port = _run_present(
        tmp_path, monkeypatch, "--public", "ssh", steps=[follow_the_link]
    )

    assert result.exit_code == 0, result.output
    url = browser_spy[0]["argv"][-1]
    assert re.fullmatch(rf"http://127\.0\.0\.1:{port}/\?admin=\S+", url)
    token = url.rpartition("=")[2]
    assert f"/?admin={token}" in result.stdout
    assert answers["status"] == 303
    assert f"mentipy_admin={token}" in answers["cookie"]
