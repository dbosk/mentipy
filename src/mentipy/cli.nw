Terminal output still needs small presentation helpers.  Question text is
collapsed to a single line before truncation or wrapping so stored newlines do
not break the table layout.

<<functions>>=
def _single_line_text(text: str) -> str:
    return " ".join(text.split())


def _question_summary(text: str, max_width: Optional[int]) -> str:
    text = _single_line_text(text)
    if max_width is None or len(text) <= max_width:
        return text
    if max_width <= 3:
        return text[:max_width]
    return text[: max_width - 3] + "..."


def _terminal_width() -> int:
    return shutil.get_terminal_size((LIST_FALLBACK_WIDTH, 24)).columns


def _listing_text_width() -> Optional[int]:
    if not sys.stdout.isatty():
        return None
    return _terminal_width()
@

Open answers often use Markdown for emphasis, lists, and fenced code blocks.
They must reach Rich as renderables rather than as pre-rendered strings;
otherwise terminal colour and syntax highlighting are lost before [[view]] or
[[watch]] can print them.

<<functions>>=
def _result_console() -> Console:
    return Console(width=_terminal_width())
@

The default listing optimises for scanning: prefix first, then a summary that
fits the remaining terminal width.  When stdout is not a TTY (piped or
redirected), the summary skips truncation entirely so downstream tools see one
full record per line.  The [[--full]] variant is the explicit "give me the
whole question" form: it always prints the full single-line text, letting the
terminal soft-wrap if it must.  With piping doing the right thing
automatically, the difference between the two modes is just whether mentipy
itself is willing to truncate.

<<functions>>=
def _question_listing(entries: list[dict[str, object]], *, full: bool) -> str:
    if not entries:
        return "No questions registered yet."

    prefix_width = max(len(str(entry["url_prefix"])) for entry in entries)
    gap = " " * LIST_COLUMN_GAP

    if full:
        return "\n".join(
            f"{str(entry['url_prefix']):<{prefix_width}}{gap}"
            f"{_single_line_text(str(entry['text']))}"
            for entry in entries
        )

    total = _listing_text_width()
    text_width = (
        None
        if total is None
        else max(1, total - prefix_width - LIST_COLUMN_GAP)
    )

    return "\n".join(
        f"{str(entry['url_prefix']):<{prefix_width}}{gap}"
        f"{_question_summary(str(entry['text']), text_width)}"
        for entry in entries
    )
@

The terminal bar chart is the same visualisation as the HTML results page: one
row per category, a bar proportional to the relative count, and a numeric count
with its rounded percentage.  The layout reserves space for the bar and count
first, then shortens overlong labels if needed and pads the count text to a
shared width.  That keeps long options from squeezing out the visualisation and
keeps numeric buckets easy to scan.

<<functions>>=
def _render_terminal_bar_chart(
    labels: list[str],
    counts: list[int],
    percentages: list[float],
    *,
    console: Console,
):
    collapsed_labels = [_single_line_text(str(label)) for label in labels]
    numeric_labels = all(
        label.lstrip("-").isdigit() for label in collapsed_labels
    )
    count_digits = max((len(str(count)) for count in counts), default=1)
    percentage_digits = max(
        (len(f"{percentage:.0f}") for percentage in percentages),
        default=1,
    )
    count_texts = [
        f"{count:>{count_digits}} ({percentage:>{percentage_digits}.0f}%)"
        for count, percentage in zip(counts, percentages)
    ]
    count_width = max((len(text) for text in count_texts), default=0)
    available = max(console.width - count_width - 4, 2)
    max_label_width = max(
        (len(label) for label in collapsed_labels),
        default=1,
    )
    label_width = min(max_label_width, max(1, available - TERMINAL_BAR_MIN_WIDTH))
    bar_width = max(1, available - label_width)

    table = Table.grid(padding=(0, 2))
    table.add_column(
        width=label_width,
        justify="right" if numeric_labels else "left",
        no_wrap=True,
    )
    table.add_column(width=bar_width, no_wrap=True)
    table.add_column(width=count_width, justify="right", no_wrap=True)

    for shown_label, percentage, count_text in zip(
        collapsed_labels,
        percentages,
        count_texts,
    ):
        if len(shown_label) > label_width:
            if label_width > 3:
                shown_label = shown_label[: label_width - 3] + "..."
            else:
                shown_label = shown_label[:label_width]

        table.add_row(
            Text(shown_label),
            Bar(
                TERMINAL_BAR_SIZE,
                0,
                percentage,
                width=bar_width,
                color="cyan",
                bgcolor="grey23",
            ),
            count_text,
        )

    console.print(table)
@

The alignment test uses one long and one short label because that is where a
