\section{Presenting contracts}

[[present]] must offer exactly [[serve]]'s options plus [[watch]]'s
display options, and the options of its own listed here, which only
[[present]] has.  Reading them from the Typer command objects, rather
than listing them here, makes the test catch a flag added to either
command later: the new flag has to reach [[present]] too, or be
deliberately excluded here as PREFIX and [[--server]] are.

<<test functions>>=
def _option_declarations(name):
    command = typer.main.get_command(cli).commands[name]
    return {
        (
            param.name,
            tuple(param.opts),
            tuple(param.secondary_opts),
            getattr(param, "help", None),
        )
        for param in command.params
    }


PRESENT_ONLY_OPTIONS = {"open_browser", "open_with"}


def test_present_takes_the_options_of_serve_and_watch():
    watch_display = {
        option
        for option in _option_declarations("watch")
        if option[0] not in ("prefix", "server")
    }
    present = _option_declarations("present")

    assert {
        option for option in present if option[0] not in PRESENT_ONLY_OPTIONS
    } == (_option_declarations("serve") | watch_display)
    assert {option[0] for option in present} >= PRESENT_ONLY_OPTIONS
@

The main run starts a real server on a free port through [[present]]
and plays the lecture through the sleep stub, as the watch tests do.
The banner opens every frame after a clear, and the waiting line names
the server's own loopback address.  An answer from before the start
checks that the window reaches the watcher: the session window, the
default, leaves it out.  When the loop ends, nothing
listens on the port any more: the server was shut down, not left
behind in its thread.

<<test functions>>=
def _free_port():
    with socket.socket() as probe:
        probe.bind(("127.0.0.1", 0))
        return probe.getsockname()[1]


def test_present_serves_and_follows_the_lecture(tmp_path, monkeypatch):
    monkeypatch.setenv("MENTIPY_CONFIG", str(tmp_path / "config.json"))
    port = _free_port()
    server = f"http://127.0.0.1:{port}"
    set_setting("base_url", server)
    store = Store(tmp_path / "mentipy.json", min_prefix=4)
    prefix = store.register(MCQuestion("Pick one", ("A", "B")))
    store.record(store.resolve(prefix), 0)
    monkeypatch.setattr("mentipy.cli.CLEAR_SCREEN", "[clear]")
    closed = []
    close = mentipy.server.ThreadingHTTPServer.server_close

    def spy_close(self):
        closed.append(self.server_address[1])
        close(self)

    monkeypatch.setattr(
        mentipy.server.ThreadingHTTPServer, "server_close", spy_close
    )
    _play_the_lecture(
        monkeypatch,
        lambda: None,
        lambda: _open_for_the_room(server, prefix),
    )

    result = CliRunner().invoke(
        cli,
        [
            "present",
            "--host",
            "127.0.0.1",
            "--port",
            str(port),
            "--store",
            str(store.path),
        ],
    )

    out = result.stdout
    assert result.exit_code == 0, result.output
    assert out.startswith(f"Serving at {server}\n")
    assert out.count(f"No question is open yet at {server}.") == 1
    assert out.index("No question is open yet") < out.index("Pick one")
    assert "Responses: 0 (since the last server start)" in out
    frames = out.split("[clear]")[1:]
    assert len(frames) >= 2
    assert all(frame.startswith(f"Serving at {server}\n") for frame in frames)
    assert closed == [port]
    with pytest.raises(ConnectionRefusedError):
        socket.create_connection(("127.0.0.1", port), timeout=1)
