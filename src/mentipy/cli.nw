On Windows the command is split without the POSIX rules, which would
read the backslashes of a path as escapes, and one pair of quotes
around a token is removed, so a path with spaces can be quoted.  The
process is detached through creation flags rather than a new session.
The flags exist only in Windows's [[subprocess]], so the test supplies
them, with their Windows values, and sets the platform.

<<test functions>>=
@pytest.mark.parametrize(
    "command, argv",
    [
        (r"C:\Users\me\chrome.exe", [r"C:\Users\me\chrome.exe", "URL"]),
        (
            r'"C:\Program Files\Google\chrome.exe" --new-window',
            [r"C:\Program Files\Google\chrome.exe", "--new-window", "URL"],
        ),
        ("explorer", ["explorer", "URL"]),
        ("'C:\\b r\\x.exe' --app={url}", [r"C:\b r\x.exe", "--app=URL"]),
    ],
    ids=["path", "quoted-path", "explorer", "single-quotes"],
)
def test_open_browser_keeps_windows_paths(
    monkeypatch, browser_spy, command, argv
):
    monkeypatch.setattr(sys, "platform", "win32")
    monkeypatch.setattr(
        subprocess, "CREATE_NEW_PROCESS_GROUP", 0x200, raising=False
    )
    monkeypatch.setattr(subprocess, "DETACHED_PROCESS", 0x8, raising=False)
    url = "http://127.0.0.1:8080/"

    mentipy.cli._open_browser(command, url)

    assert browser_spy[0]["argv"] == [
        arg.replace("URL", url) for arg in argv
    ]
    assert browser_spy[0]["options"] == {
        "stdin": subprocess.DEVNULL,
        "stdout": subprocess.DEVNULL,
        "stderr": subprocess.DEVNULL,
        "creationflags": 0x208,
    }
