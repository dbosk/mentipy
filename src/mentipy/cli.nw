    store = Store(tmp_path / "mentipy.json", min_prefix=4)
    first = store.register(OpenQuestion("Comment?"))
    second = store.register(MCQuestion("Pick one", ("A", "B")))
    store.record(store.resolve(first), "from an earlier lecture")
    monkeypatch.setattr("mentipy.cli.CLEAR_SCREEN", "[clear]")

    with _serving(store) as server:
        _open_for_the_room(server, first)
        store.record(store.resolve(first), "early answer")

        def move_on():
            _open_for_the_room(server, second)
            store.record(store.resolve(second), 1)

        _play_the_lecture(
            monkeypatch,
            lambda: store.record(store.resolve(first), "late answer"),
            lambda: None,
