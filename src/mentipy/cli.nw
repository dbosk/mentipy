@

Word-cloud results have no individual-answer transcript: each answer
collapses into a tally that contributes to the cloud, so the terminal
view shows the same descending frequency list the HTML page consumes,
formatted as a Rich [[Table]] for readability.  We cap the table to a
sensible top--N so a long-tail cloud does not flood a small terminal.
The total counts come first because they describe the cloud at a
glance (how busy and how diverse), the same role that [[Avg length]]
plays for open-text answers.  The table mirrors the HTML results page:
exact counts stay visible, and percentages make the long tail easier to
scan at a glance.

<<constants>>=
TERMINAL_WORDCLOUD_TOP_N = 25
@

<<functions>>=
def _render_terminal_wordcloud(results: dict, *, console: Console):
    frequencies = list(results.get("frequencies") or [])
    if not frequencies:
        console.print("No answers yet.")
        return

    total_tokens = int(results.get("total_tokens") or 0)
    if not total_tokens:
        total_tokens = sum(int(entry[1]) for entry in frequencies)
    denominator = total_tokens or 1

    console.print(_stats_line([
        ("Words", str(total_tokens)),
        ("Distinct", str(results.get("unique_words", 0))),
    ]))

    table = Table(show_header=True, header_style="bold")
    table.add_column("Word")
    table.add_column(f"Count ({total_tokens})", justify="right")
    table.add_column("Percentage", justify="right")
    for entry in frequencies[:TERMINAL_WORDCLOUD_TOP_N]:
        word, count = entry[0], entry[1]
        table.add_row(
            Text(str(word)),
            str(count),
            f"{int(count) / denominator * 100:.1f}%",
        )
    console.print(table)

    remaining = len(frequencies) - TERMINAL_WORDCLOUD_TOP_N
    if remaining > 0:
        console.print(
            f"(+ {remaining} more word"
            f"{'s' if remaining != 1 else ''})"
        )
