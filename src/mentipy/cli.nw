\section{Shared command helpers}

The first helper family centralises configuration defaults.  Command functions
should not have to remember how missing [[--store]], [[--port]], or
[[--base-url]] values map onto persisted settings; they should only decide
which explicit command-line value, if any, takes precedence.

<<functions>>=
def _configured_store(path: str | None) -> Store:
    return Store(path or get_setting(STORE_CONFIG, DEFAULT_STORE_PATH))


def _configured_port(port: int | None) -> int:
    return int(port or get_setting(PORT_CONFIG, DEFAULT_PORT))


def _configured_venv(path: str | None) -> Path:
    return Path(path or get_setting(VENV_CONFIG, DEFAULT_VENV_PATH))


def _configured_base(base: str | None) -> str | None:
    if base is not None:
        return base
    return get_setting(BASE_URL_CONFIG)


def _format_index_hint(public_url: str, host: str, port: int) -> str:
    public_index = public_url.rstrip("/") + "/"
    bind_host = _index_url_host(host)
    bind_index = f"http://{bind_host}:{port}/"
    return (
        "Open the question index at:\n"
        f"  {public_index}\n"
        f"  {bind_index}"
    )


def _format_lock_hint(public_url: str) -> str:
    active_url = public_url.rstrip("/") + "/active"
    return (
        "Questions open for respondents as you open their results pages "
        "(open the first one before showing its slide).\n"
        f"Latecomers can use {active_url}; --no-lock serves everything."
    )


def _index_host(host: str) -> str:
    try:
        address = ipaddress.ip_address(host)
    except ValueError:
        return host
    if address.is_loopback or address.is_unspecified:
        return "localhost"
    return host


def _index_url_host(host: str) -> str:
    bind_host = _index_host(host)
    try:
        address = ipaddress.ip_address(bind_host)
    except ValueError:
        return bind_host
    if address.version == 6:
        return f"[{bind_host}]"
    return bind_host
@

TyperConf already provides the path-based configuration command shape we want.
We register that command directly and point it at Mentipy's config file so the
CLI and Python-side helpers read the same settings.

<<functions>>=
def _add_config_command(app: typer.Typer, *, conf_path: str | None = None):
    typerconf.add_config_typer(
        app,
        conf_path=conf_path or str(config_path()),
    )
@

The LaTeX reference command is plain text on purpose.  It should be easy to
page through in a terminal while still naming the helper signatures and the
config keys that influence authoring.  The reference itself stays in
English whatever the locale; it lists the slide-label macros a deck may
define (\cref{sec:slide-labels}) from the same table the helpers use,
spliced in after the dedent because the wrapped list carries its own
indentation.

<<functions>>=
def _latex_reference() -> str:
    label_lines = textwrap.fill(
        ", ".join(f"\\{name}" for name in SLIDE_LABEL_MACROS.values()),
        width=76,
        initial_indent="      ",
        subsequent_indent="      ",
    )
    config_lines = "\n".join(
        textwrap.fill(
            f"{key}: {description}",
            width=76,
            initial_indent="  ",
            subsequent_indent="    ",
        )
        for key, description in CONFIG_KEY_HELP
    )
    return textwrap.dedent(
        f"""\
        Mentipy LaTeX reference

        Use `mentipy.latex` from PythonTeX or another Python block.

        Public helpers
          from `mentipy.latex` import (file_download, file_snippet,
                                       mc, open_text, pin_image,
                                       pin_text, question, ranking,
                                       scale, word_cloud,
                                       write_snippet)

          mc(text, options, *, multi=False, next=True, results=None,
             lock=True, context=(), store=None, base_url=None,
             qr_dir=None, qr_format=None, environment=None,
             show_url=None, layout="slide", locale=None)
          open_text(text, *, max_chars=280, fence=None, next=True,
             results=None, lock=True, context=(), store=None,
             base_url=None, qr_dir=None, qr_format=None,
             environment=None, show_url=None, layout="slide", locale=None)
          pin_image(text, image_path, *, max_pins=1,
             allow_comment=False, next=True, results=None, lock=True,
             context=(), store=None, base_url=None, qr_dir=None,
             qr_format=None, environment=None, show_url=None,
             layout="slide", locale=None)
          pin_text(text, content, *, language=None, max_pins=1,
             allow_comment=False, next=True, results=None, lock=True,
             context=(), store=None, base_url=None, qr_dir=None,
             qr_format=None, environment=None, show_url=None,
             layout="slide", locale=None)
          ranking(text, options, *, top_n=None, next=True,
             results=None, lock=True, context=(), store=None,
             base_url=None, qr_dir=None, qr_format=None,
             environment=None, show_url=None, layout="slide", locale=None)
          scale(text, *, low=1, high=5, low_label="", high_label="",
             next=True, results=None, lock=True, context=(),
             store=None, base_url=None, qr_dir=None, qr_format=None,
             environment=None, show_url=None, layout="slide", locale=None)
          word_cloud(text, *, max_chars=280, split_words=True,
             separators=None, min_word_length=3, extra_stop_words=(),
             use_default_stopwords=True, render="svg", next=True,
             results=None, lock=True, context=(), store=None,
             base_url=None, qr_dir=None, qr_format=None,
             environment=None, show_url=None, layout="slide", locale=None)
          question(question_obj, *, ...) renders a prebuilt Question
             object and is the lower-level helper behind them.
          write_snippet(name, latex, *, directory=None) writes a
             helper's LaTeX to <qr_dir>/<name>.tex, so a Beamer frame
             can \\mentipyinput{{name}} it instead of running
             PythonTeX inside the frame.

        Per-question keyword arguments
          next: render a 'Next →' link on the post-submit and results
            pages.  True by default; pass next=False on the final
            question of a lecture.  Presentation-only; does not affect
            the question's canonical hash.
          results: override `mentipy serve --results` for this
            question.  results=True shows respondents the live tally
            even on a private server; results=False hides it even when
            the server runs with --results; the default None follows
            the server flag.  The lecturer's local/admin access is
            never blocked.  Presentation-only; does not affect the
            question's canonical hash.
          lock: pace this question with the slides.  lock=True (the
            default) keeps it locked for respondents until you open
            its results page while `mentipy serve` runs with the lock
            on; lock=False opens it as soon as the question before it
            in the deck is open, for questions that share a slide
            with their predecessor.  Presentation-only; does not
            affect the question's canonical hash.
          context: material shown on the answer page, after the
            question and its inputs, and on the results page, after
            the aggregate results and before any list of answers;
            never on the slide.  One item or a list: a string is
            prose, a
            ContextSnippet(text, language=None, label=None) is shown
            as is, and two helpers read files:
            file_snippet(path, *, name=None, language=None,
              label=None) shows a file, or with name="Account" or
              "Account.deposit" one class or function of it;
            file_download(path, *, label=None) offers a file for
              download, for data too large to read on a phone.
            Show only the premises, never the answer.  The premises
            (snippet text, download bytes) are part of the question's
            identity: editing them gives a new URL and QR code, while
            labels, languages and file names do not.

        Inline code
          Prompts and options mark code with backtick pairs, as in
            Markdown: mc("What does `len(xs)` return?", ["`2`", "`3`"]).
            The slide sets it in typewriter type; the web pages show it
            as code.  On the command line, single-quote such text: in
            double quotes the shell runs `...` as a command.

        Shared keyword arguments
          store: defaults to config key {STORE_CONFIG}
          base_url: defaults to {BASE_URL_CONFIG}; if omitted, Mentipy
            first reads that setting and only resolves the current LAN
            address using {PORT_CONFIG} when it is unset, empty, or auto
          qr_dir: defaults to {QR_DIR_CONFIG}
          qr_format: defaults to {QR_FORMAT_CONFIG}
          environment: defaults to {QUESTION_ENVIRONMENT_CONFIG};
            MENTIPY_QUESTION_ENVIRONMENT overrides it
          show_url: defaults to {SHOW_URL_CONFIG} and only affects QR-less
            article output; QR layouts caption the QR via the LaTeX
            macro \\mentipyqrcaption, which the document may redefine
          layout: slide, article, article+qr, or auto

        Slide labels
          The respondent instructions on the slide are in the language
            of the helpers' locale= keyword (en or sv), which a deck
            sets once in its shared block, else of config key
            {LOCALE_CONFIG}.  The helper records that language with the
            question, and the question's web pages follow it unless
            `mentipy serve --locale` overrides it.  The pages of no
            question (the index, /active) and of a question without a
            record follow the language that every recorded question in
            the store agrees on, else {LOCALE_CONFIG}.  Each
            label is a macro that the snippet defines with
            \\providecommand, so a deck's own definition in its
            preamble wins: \\newcommand{{\\mentipychooseone}}{{Pick one:}}.
            Between questions, \\providecommand{{\\mentipychooseone}}{{}}
            then \\renewcommand works anywhere.
            A label with a number reads it from \\mentipynumber:
            \\newcommand{{\\mentipycharacters}}{{\\mentipynumber{{}} chars}}.
            The labels:
        @LABEL_MACROS@

        Workflow
          1. Call a helper while compiling the document.
          2. The helper registers the question and writes QR assets.
          3. Run `mentipy serve` to publish the poll, or `mentipy url`
             PREFIX to inspect one canonical respondent URL.
          4. Recompile after URL changes so the PDF embeds refreshed QR codes.

        Decks bound into a book
          set_base_dir(path) (from `mentipy`) resolves the files Mentipy
            reads and writes against path: the store, QR codes, pin
            images and snippets.  A relative path is anchored where the
            PythonTeX session started; None switches it off.  Paths
            emitted into LaTeX stay as written.
          \\usepackage{{mentipy}} with \\mentipybasedir{{auto}} sets it
            from LaTeX, following the import package's \\subimport.
            `mentipy sty` prints the package; `mentipy sty --install`
            installs it into TEXMFHOME.

        Config keys
        """
    ).rstrip().replace("@LABEL_MACROS@", label_lines) + "\n" + config_lines
@

The render subcommands all expose the same layout, URL, QR, store and
locale options; [[--locale]] is the helpers' [[locale=]], so a question
rendered here records its language as one rendered by PythonTeX does.
Collecting those keyword arguments in one helper keeps the individual command
bodies focused on constructing the right question kind rather than duplicating
the shared registration/rendering policy.  The web-only context files are
shared the same way: every question kind takes a context, so the helper turns
the [[--context]] and [[--context-download]] paths into the authoring helpers'
items, shown files first.

<<functions>>=
def _render_common_kwargs(
    *,
    store: str | None,
    context: list[Path] | None,
    context_download: list[Path] | None,
    environment: str | None,
    show_url: bool | None,
    base_url: str | None,
    qr_dir: str | None,
    qr_format: str | None,
    layout: str,
    locale: str | None = None,
) -> dict:
    return {
        "store": _configured_store(store),
        "context": [file_snippet(path) for path in context or ()]
        + [file_download(path) for path in context_download or ()],
        "environment": environment,
        "show_url": show_url,
        "base_url": base_url,
        "qr_dir": qr_dir,
        "qr_format": qr_format,
        "layout": layout,
        "locale": locale,
    }
@

URL commands accept any stored prefix or full hash, but they should always
print the canonical issued prefix.  The resolver therefore first asks the store
for an exact issued prefix, then reports ambiguous partial matches as CLI input
errors instead of guessing.

<<functions>>=
def _join_url(base_url: str, prefix: str) -> str:
    return f"{base_url.rstrip('/')}/{prefix}"


def _resolve_full_hash(store: Store, prefix: str) -> str:
    full_hash = store.resolve(prefix)
    if full_hash is not None:
        return full_hash

    matches = store.matches(prefix)
    if len(matches) > 1:
        raise typer.BadParameter(f"{prefix!r} matches multiple questions")
    raise typer.BadParameter(f"{prefix!r} does not match any question")


def _canonical_prefix(store: Store, prefix: str) -> str:
    full_hash = _resolve_full_hash(store, prefix)
    return store.metadata(full_hash)["url_prefix"]
@

The prefix-oriented commands already depend on the store's issued
[[url_prefix]] metadata.  Their completion hook can therefore reuse the same
listing without adding any shell-time side effects: it reads the configured
store, honours an already-typed [[--store]] override, and quietly returns no
suggestions if the store is missing or broken.  The catch is intentionally
broad because shell completion runs in the middle of the user typing a
command, so a leaked traceback into their prompt is far worse than a missing
suggestion.  Programmer errors here surface through the matching pytest
cases below, not through the user's terminal.

<<functions>>=
def _complete_question_prefix(
    ctx: typer.Context,
    incomplete: str,
) -> list[str]:
    try:
        params = getattr(ctx, "params", {}) or {}
        store = _configured_store(params.get("store"))
        return [
            str(entry["url_prefix"])
            for entry in store.all_questions()
            if str(entry["url_prefix"]).startswith(incomplete)
        ]
    except Exception:
        return []
@

Let's verify that the completion helper lists issued prefixes, filters partial
matches, and degrades quietly when the configured store does not exist.

<<test functions>>=
def test_complete_question_prefix_lists_registered_prefixes(tmp_path):
    store = Store(tmp_path / "mentipy.json", min_prefix=4)
    prefixes = [
        store.register(OpenQuestion("First?")),
        store.register(OpenQuestion("Second?")),
    ]
    ctx = SimpleNamespace(params={"store": str(store.path)})

    assert mentipy.cli._complete_question_prefix(ctx, "") == prefixes


def test_complete_question_prefix_filters_by_incomplete(tmp_path):
    store = Store(tmp_path / "mentipy.json", min_prefix=4)
    prefixes = [
        store.register(OpenQuestion("First?")),
        store.register(OpenQuestion("Second?")),
    ]
    ctx = SimpleNamespace(params={"store": str(store.path)})
    incomplete = prefixes[0]
    for length in range(1, len(prefixes[0]) + 1):
        candidate = prefixes[0][:length]
