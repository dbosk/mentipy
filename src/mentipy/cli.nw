def test_watch_appends_open_answers_across_a_server_restart(
    tmp_path, monkeypatch
):
    store = Store(tmp_path / "mentipy.json", min_prefix=4)
    prefix = store.register(OpenQuestion("Comment?"))
    full_hash = store.resolve(prefix)
    store.record(full_hash, "from an earlier lecture")
    store.mark_server_start()
    store.record(full_hash, "before the restart")
    sleeps = 0

    def restart_then_stop(_interval):
        nonlocal sleeps
        sleeps += 1
        if sleeps == 1:
            store.mark_server_start()
            store.record(full_hash, "after the restart")
            return
        raise KeyboardInterrupt

    monkeypatch.setattr("mentipy.cli.time.sleep", restart_then_stop)

    result = CliRunner().invoke(
        cli, ["watch", prefix, "--store", str(store.path)]
    )

    assert result.exit_code == 0, result.output
    assert "from an earlier lecture" not in result.stdout
    assert "before the restart" in result.stdout
    assert "after the restart" in result.stdout
    assert result.stdout.count("Answer 1 -") == 2
    assert result.stdout.count("1 (since the last server start)") == 2
