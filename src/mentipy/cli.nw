Exports resolve the supplied prefix once and then serialise the store's result
shape.  JSON is the lossless format; CSV is the spreadsheet-friendly view for
raw answer rows.

<<cli setup>>=
@cli.command()
def export(
    prefix: str = typer.Argument(
        ...,
        autocompletion=_complete_question_prefix,
    ),
    format: str = EXPORT_FORMAT_OPTION,
    store: Optional[str] = STORE_OPTION,
):
    """Export answers for ``prefix``."""

    active_store = _configured_store(store)
    full_hash = _resolve_full_hash(active_store, prefix)
    results = active_store.results(full_hash)

    if format == "json":
        typer.echo(json.dumps(results, ensure_ascii=False, indent=2, sort_keys=True))
        return

    if format == "csv":
        typer.echo(_results_csv(results))
        return

    raise typer.BadParameter("format must be either 'json' or 'csv'")
