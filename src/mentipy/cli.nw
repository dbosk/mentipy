A phone that drops its connection makes the server log a warning.
Nothing configures logging in the command line, so Python's last-resort
handler would print it straight over the display.  The test drops real
connections: it asks for a long results page and resets the socket at
once, so the server's write fails.  The page's answers are written
into the store in one go, since recording them one by one rewrites the
file each time.  The lecture then moves to a second
question, whose frame must report the warnings in the banner's status
line, and no warning may appear anywhere else in the output.  Nor
may it reach a handler on the root logger, here pytest's capture,
which a user's logging configuration could have put there.  Afterwards
the [[mentipy]] logger is as it was.

<<test functions>>=
def _drop_connections(server, path, *, attempts=40):
    parts = urllib.parse.urlsplit(server)
    for _ in range(attempts):
        connection = socket.create_connection(
            (parts.hostname, parts.port), timeout=5
        )
        connection.sendall(
            f"GET {path} HTTP/1.1\r\nHost: x\r\n\r\n".encode()
        )
        connection.setsockopt(
            socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0)
        )
        connection.close()


def test_present_keeps_server_warnings_in_the_banner(
    tmp_path, monkeypatch, caplog
):
    caplog.set_level(logging.WARNING)
    monkeypatch.setenv("MENTIPY_CONFIG", str(tmp_path / "config.json"))
    port = _free_port()
    server = f"http://127.0.0.1:{port}"
    set_setting("base_url", server)
    store = Store(tmp_path / "mentipy.json", min_prefix=4)
    long = store.register(OpenQuestion("Comment?"))
    store.record(store.resolve(long), "an answer " * 10)
    data = store._data()
    answers = data["answers"][store.resolve(long)]
    answers.extend(dict(answers[0]) for _ in range(1500))
    store._write(data)
    short = store.register(MCQuestion("Pick one", ("A", "B")))
    monkeypatch.setattr("mentipy.cli.CLEAR_SCREEN", "[clear]")
    real_sleep = time.sleep

    def drop_then_wait():
        _drop_connections(server, f"/{long}/results?window=all")
        real_sleep(0.5)

    _play_the_lecture(
        monkeypatch,
        drop_then_wait,
        lambda: _open_for_the_room(server, short),
    )

    result = CliRunner().invoke(
        cli,
        [
            "present",
            "--host",
            "127.0.0.1",
            "--port",
            str(port),
            "--store",
            str(store.path),
            "--no-lock",
        ],
    )

    assert result.exit_code == 0, result.output
    last_frame = result.output.split("[clear]")[-1]
    assert re.search(r"^Warnings: \d+, the last: ignored network error",
                     last_frame, re.M)
    for line in result.output.splitlines():
        if "ignored network error" in line:
            assert line.startswith("Warnings: ")
    assert not caplog.records
    mentipy_logger = logging.getLogger("mentipy")
    assert mentipy_logger.handlers == []
    assert mentipy_logger.propagate is True
