def _not_mentipy(status, location=None):
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(status)
            if location is not None:
                self.send_header("Location", location)
            self.send_header("Content-Length", "0")
            self.end_headers()

        def log_message(self, *_args):
            pass

    return Handler


@pytest.mark.parametrize(
    "status, location, reported",
    [
        (404, None, "answered 404 Not Found to /active"),
        (303, "/", "answered 303 See Other to /active"),
        (200, None, "answered 200 OK to /active"),
    ],
)
def test_watch_reports_a_server_that_does_not_know_active(
    tmp_path, monkeypatch, status, location, reported
):
    other = HTTPServer(("127.0.0.1", 0), _not_mentipy(status, location))
    thread = threading.Thread(target=other.serve_forever, daemon=True)
    thread.start()
    _play_the_lecture(monkeypatch)
    try:
        result = CliRunner().invoke(
            cli,
            [
                "watch",
                "--store",
                str(tmp_path / "mentipy.json"),
                "--server",
                f"http://127.0.0.1:{other.server_address[1]}",
            ],
        )
    finally:
        other.shutdown()
        thread.join()
        other.server_close()

    assert result.exit_code == 0, result.output
    assert reported in result.stdout
    assert "No question is open yet" not in result.stdout
    assert "The active question" not in result.stdout
