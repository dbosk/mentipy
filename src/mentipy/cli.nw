The companion LaTeX package (\cref{chap:sty}) ships inside the Python
package, where TeX cannot find it.  The [[sty]] command bridges the
gap in the two ways authors need.  By default it prints the package, so
a course repository can vendor it next to its documents
([[mentipy sty > mentipy.sty]]) and pin the version it built with.
With [[--install]] it copies the package into the user's personal TeX
tree, whose location [[kpsewhich]] reports, so that every document on
the machine finds it.  That tree is searched without a filename
database, so no [[mktexlsr]] run is needed afterwards.

<<cli setup>>=
@cli.command()
def sty(install: bool = STY_INSTALL_OPTION):
    """Print the companion LaTeX package, or install it for TeX."""

    text = _sty_text()
    if not install:
        typer.echo(text, nl=False)
        return
    target = _texmf_home() / "tex" / "latex" / "mentipy" / "mentipy.sty"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text, encoding="utf-8")
    typer.echo(str(target))
<<constants>>=
STY_INSTALL_OPTION = typer.Option(
    False,
    "--install",
    help="Install mentipy.sty into TEXMFHOME instead of printing it.",
)
<<functions>>=
def _sty_text() -> str:
    return (
        resources.files("mentipy")
        .joinpath("mentipy.sty")
        .read_text(encoding="utf-8")
    )


def _texmf_home() -> Path:
    try:
        completed = subprocess.run(
            ["kpsewhich", "-var-value", "TEXMFHOME"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (FileNotFoundError, subprocess.CalledProcessError) as error:
        raise typer.BadParameter(
            "cannot locate TEXMFHOME with kpsewhich; run `mentipy sty`"
            " and save the output next to your document instead"
        ) from error
    return Path(completed.stdout.strip())
@

